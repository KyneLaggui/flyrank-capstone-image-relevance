POSTGRES_DB=image_matching
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here

DATABASE_URL=postgresql+psycopg://postgres:your_password_here@localhost:5432/image_matching

GEMINI_API_KEY=your_gemini_api_key_here

GEMINI_MODEL=gemini-3.7-flash

VISION_CONFIDENCE_THRESHOLD=0.70

GEMINI_INPUT_PRICE_PER_MILLION=0.75
GEMINI_OUTPUT_PRICE_PER_MILLION=3.75

VISION_PROVIDER=ollama

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

EMBEDDING_MODEL=all-minilm

MATCH_SIMILARITY_THRESHOLD=0.50